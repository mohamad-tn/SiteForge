generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum DomainStatus {
  none
  pending
  active
  error
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sites        Site[]
  mediaAssets  MediaAsset[]
  aiQuota      TenantAiQuota?
  aiSettings   UserAiSettings?
  aiChatThreads AiChatThread[]

  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model Template {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameAr        String
  description   String
  descriptionAr String
  category      String
  thumbnail     String?
  content       Json
  createdAt     DateTime @default(now())

  @@index([category])
}

model Site {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  ownerId          String
  owner            User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  draftContent     Json
  publishedContent Json?
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  ogImage          String?
  favicon          String?
  customCss        String?
  customDomain     String?       @unique
  domainStatus     DomainStatus  @default(none)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  events           SiteEvent[]
  collections      Collection[]
  formSubmissions  FormSubmission[]
  secrets          SiteSecret[]
  mediaAssets      MediaAsset[]
  aiChatThreads    AiChatThread[]

  @@index([ownerId])
  @@index([customDomain])
  @@index([domainStatus])
  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([publishedAt])
  @@index([updatedAt])
  @@index([createdAt])
}

model SiteEvent {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  path      String?
  locale    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([siteId, type])
  @@index([createdAt])
}

model Collection {
  id        String           @id @default(cuid())
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  fields    Json
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     CollectionItem[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  data         Json
  sort         Int        @default(0)
  published    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId, sort])
  @@index([collectionId, published])
}

model FormSubmission {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blockId   String?
  data      Json
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([siteId, blockId])
}

model SiteSecret {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Unique per site; referenced as secret:NAME or {{secret:NAME}} in httpAction
  name      String
  /// AES-256-GCM ciphertext (never returned by owner APIs after write)
  valueEnc  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name      String
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([siteId])
  @@index([name])
  @@index([createdAt])
}



enum AiProvider {
  openai
  anthropic
  google
  xai
}

/// Singleton platform AI config (id = "default"). API key encrypted at rest (AES-256-GCM).
model PlatformAiSettings {
  id                 String     @id @default("default")
  provider           AiProvider @default(openai)
  /// AES-256-GCM ciphertext via encryptSecret — never returned plaintext to clients
  encryptedApiKey    String?
  model              String     @default("gpt-4o-mini")
  enabled            Boolean    @default(false)
  defaultDailyLimit  Int        @default(20)
  maxTokens          Int        @default(4096)
  updatedAt          DateTime   @updatedAt
}

model TenantAiQuota {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = use PlatformAiSettings.defaultDailyLimit
  dailyLimit Int?
  usedToday  Int      @default(0)
  resetDate  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resetDate])
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  siteId    String?
  provider  String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  ok        Boolean  @default(true)
  error     String?
  /// platform | user — which API key was used
  keySource String   @default("platform")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([siteId, createdAt])
  @@index([createdAt])
  @@index([keySource, createdAt])
}

model AiChatThread {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]

  @@unique([userId, siteId])
  @@index([siteId])
  @@index([userId, updatedAt])
}

model AiChatMessage {
  id             String       @id @default(cuid())
  threadId       String
  thread         AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role           String
  text           String
  /// Attachment chips meta (no large dataUrls persisted)
  attachmentMeta Json?
  steps          Json?
  /// ok | error | cancelled | partial
  status         String       @default("ok")
  createdAt      DateTime     @default(now())

  @@index([threadId, createdAt])
}

/// Per-user BYOK AI settings (encrypted key). When enabled, bypasses platform quota.
model UserAiSettings {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AiProvider @default(openai)
  encryptedApiKey String?
  model           String     @default("gpt-4o-mini")
  enabled         Boolean    @default(false)
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())
}
